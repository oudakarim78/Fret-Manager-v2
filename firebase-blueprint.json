{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public profile metadata for a Firebase-authenticated user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID.",
          "maxLength": 128
        },
        "displayName": {
          "type": "string",
          "description": "Display name.",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "role", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Private PII record isolated under users/{userId}/private/{docId}.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "updatedAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Multi-tenant transport company workspace metadata, licensing, and settings.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "code": {
          "type": "string",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "pack": {
          "type": "string",
          "maxLength": 64
        },
        "licenseStatus": {
          "type": "string",
          "enum": ["essai_gratuit", "en_attente_activation", "actif", "suspendu"]
        },
        "validUntil": {
          "type": "string",
          "maxLength": 32
        },
        "currency": {
          "type": "string",
          "enum": ["MAD", "EUR"]
        },
        "setupFee": {
          "type": "number"
        },
        "annualFee": {
          "type": "number"
        },
        "maxVehicles": {
          "type": "number"
        },
        "maxUsers": {
          "type": "number"
        },
        "gpsEnabled": {
          "type": "boolean"
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "companySettings": {
          "type": "object"
        },
        "invoiceSettings": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "code",
        "name",
        "pack",
        "licenseStatus",
        "validUntil",
        "currency",
        "setupFee",
        "annualFee",
        "maxVehicles",
        "maxUsers",
        "gpsEnabled",
        "notes",
        "companySettings",
        "invoiceSettings",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceRecord": {
      "title": "WorkspaceRecord",
      "description": "Individual entity record belonging to a parent workspace (user, vehicle, driver, client, trip, expense, invoice, GPS, checklist, audit).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workspaceId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "recordType": {
          "type": "string",
          "enum": [
            "user",
            "vehicle",
            "driver",
            "client",
            "country",
            "city",
            "trip",
            "expense",
            "maintenance",
            "document",
            "employee",
            "payroll",
            "payroll_allocation",
            "client_proposal",
            "invoice",
            "invoice_payment",
            "gps_device",
            "gps_position",
            "gps_alert",
            "gps_trip_summary",
            "gps_geofence",
            "gps_device_event",
            "audit_log",
            "checklist"
          ]
        },
        "payload": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "workspaceId",
        "ownerUid",
        "recordType",
        "payload",
        "createdAt",
        "updatedAt"
      ]
    },
    "B2BPack": {
      "title": "B2BPack",
      "description": "Editable B2B turnkey offer catalog item managed from Portail Éditeur.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "maxLength": 160
        },
        "audience": {
          "type": "string",
          "maxLength": 400
        },
        "setupFeeMad": {
          "type": "number"
        },
        "annualFeeMad": {
          "type": "number"
        },
        "setupFeeEur": {
          "type": "number"
        },
        "annualFeeEur": {
          "type": "number"
        },
        "maxVehicles": {
          "type": "number"
        },
        "maxUsers": {
          "type": "number"
        },
        "gpsEnabled": {
          "type": "boolean"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "customized": {
          "type": "boolean"
        },
        "logisticsBenefit": {
          "type": "string",
          "maxLength": 600
        },
        "deliverables": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "name",
        "audience",
        "setupFeeMad",
        "annualFeeMad",
        "setupFeeEur",
        "annualFeeEur",
        "maxVehicles",
        "maxUsers",
        "gpsEnabled",
        "isFeatured",
        "customized",
        "logisticsBenefit",
        "deliverables",
        "createdAt",
        "updatedAt"
      ]
    },
    "B2BRequest": {
      "title": "B2BRequest",
      "description": "B2B subscription or deployment request submitted by a client company.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "maxLength": 128
        },
        "companyName": {
          "type": "string",
          "maxLength": 160
        },
        "contactName": {
          "type": "string",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "fleetSize": {
          "type": "number"
        },
        "pack": {
          "type": "string",
          "maxLength": 64
        },
        "currency": {
          "type": "string",
          "enum": ["MAD", "EUR"]
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["nouvelle", "contactee", "en_deploiement", "convertie", "archivee"]
        },
        "provisionedWorkspaceCode": {
          "type": "string",
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerUid",
        "companyName",
        "contactName",
        "phone",
        "email",
        "fleetSize",
        "pack",
        "currency",
        "notes",
        "status",
        "provisionedWorkspaceCode",
        "createdAt",
        "updatedAt"
      ]
    },
    "VendorSettings": {
      "title": "VendorSettings",
      "description": "Editor/Owner company details, logo, and billing preferences for Portail Editeur.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "companyName": { "type": "string", "maxLength": 160 },
        "legalForm": { "type": "string", "maxLength": 80 },
        "activity": { "type": "string", "maxLength": 200 },
        "ice": { "type": "string", "maxLength": 60 },
        "ifNumber": { "type": "string", "maxLength": 60 },
        "rc": { "type": "string", "maxLength": 60 },
        "patente": { "type": "string", "maxLength": 60 },
        "bank": { "type": "string", "maxLength": 120 },
        "rib": { "type": "string", "maxLength": 80 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "maxLength": 160 },
        "website": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 250000 },
        "quotePrefix": { "type": "string", "maxLength": 32 },
        "invoicePrefix": { "type": "string", "maxLength": 32 },
        "defaultTaxRate": { "type": "number" },
        "paymentTerms": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "ownerUid", "companyName", "legalForm", "activity", "ice", "ifNumber",
        "rc", "patente", "bank", "rib", "address", "city", "phone", "email", "website",
        "logoUrl", "quotePrefix", "invoicePrefix", "defaultTaxRate", "paymentTerms",
        "createdAt", "updatedAt"
      ]
    },
    "VendorBillingDoc": {
      "title": "VendorBillingDoc",
      "description": "B2B quote or invoice edited and issued by the platform owner.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "docType": { "type": "string", "enum": ["devis", "facture"] },
        "docNumber": { "type": "string", "maxLength": 64 },
        "workspaceId": { "type": "string", "maxLength": 128 },
        "requestId": { "type": "string", "maxLength": 128 },
        "sourceQuoteId": { "type": "string", "maxLength": 128 },
        "clientName": { "type": "string", "maxLength": 160 },
        "clientContact": { "type": "string", "maxLength": 120 },
        "clientIce": { "type": "string", "maxLength": 60 },
        "clientPhone": { "type": "string", "maxLength": 40 },
        "clientEmail": { "type": "string", "maxLength": 160 },
        "clientAddress": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "enum": ["MAD", "EUR"] },
        "issueDate": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["brouillon", "envoye", "paye", "annule"] },
        "taxRate": { "type": "number" },
        "items": { "type": "array" },
        "subtotalHt": { "type": "number" },
        "taxAmount": { "type": "number" },
        "totalTtc": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id", "ownerUid", "docType", "docNumber", "workspaceId", "requestId", "sourceQuoteId",
        "clientName", "clientContact", "clientIce", "clientPhone", "clientEmail", "clientAddress",
        "currency", "issueDate", "dueDate", "status", "taxRate", "items", "subtotalHt",
        "taxAmount", "totalTtc", "notes", "createdAt", "updatedAt"
      ]
    },
    "VendorAccountRecord": {
      "title": "VendorAccountRecord",
      "description": "Platform owner/editor credential and profile record (admin-only).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "passwordHash": { "type": "string", "maxLength": 512 },
        "fullName": { "type": "string", "maxLength": 120 },
        "companyRole": { "type": "string", "maxLength": 160 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "email", "passwordHash", "fullName", "companyRole", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public Firebase user metadata."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private PII document isolated from public user profile."
    },
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/Workspace" },
      "description": "Company transport workspaces created by users or provisioned by vendor."
    },
    "/workspaces/{workspaceId}/records/{recordId}": {
      "schema": { "$ref": "#/entities/WorkspaceRecord" },
      "description": "Subcollection of operational records belonging to a workspace."
    },
    "/b2b_packs/{packId}": {
      "schema": { "$ref": "#/entities/B2BPack" },
      "description": "Persisted B2B service pack catalog managed in Portail Éditeur."
    },
    "/b2b_requests/{requestId}": {
      "schema": { "$ref": "#/entities/B2BRequest" },
      "description": "Client B2B subscription and deployment requests."
    },
    "/vendor_portal/{docId}": {
      "schema": { "$ref": "#/entities/VendorSettings" },
      "description": "Admin-only editor company settings."
    },
    "/vendor_billing_docs/{docId}": {
      "schema": { "$ref": "#/entities/VendorBillingDoc" },
      "description": "Admin-only B2B quotes and invoices."
    },
    "/vendor_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/VendorAccountRecord" },
      "description": "Admin-only editor portal accounts."
    }
  }
}
